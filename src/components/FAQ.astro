---
import { faqs } from '../data/siteData';
---

<section id="faq" class="py-20 bg-slate-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">よくある質問</h2>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        商品・お取引・サポートに関するよくあるご質問をご案内します。
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="faq-item bg-slate-900 rounded-xl border border-slate-700 hover:border-orange-500 transition-all">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="text-xl font-bold text-white pr-4">{faq.question}</h3>
            <i class="faq-icon ri-arrow-down-s-line text-2xl text-orange-500 transition-transform shrink-0"></i>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-gray-300 leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
</style>

