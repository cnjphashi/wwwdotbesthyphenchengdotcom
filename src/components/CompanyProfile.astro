---
import { companyProfile } from '../data/siteData';
---

<section id="company-profile" class="py-20 bg-bg-primary">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-medium text-primary mb-4">
        会社概要
      </h2>
      <p class="text-xl text-text-primary max-w-2xl mx-auto">
        HATCATOYを運営する会社情報をご紹介します。
      </p>
    </div>

    <div class=" rounded-xl border border-border-accent overflow-hidden">

      {companyProfile.map((item) => (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 px-6 py-6 border-b border-border-accent last:border-b-0">

          <div class="text-text-secondary text-lg">
            {item.title}
          </div>

          <div class="md:col-span-2 text-text-primary leading-relaxed">
            {
              Array.isArray(item.description)
                ? item.description.map((line) => (
                    <div>{line}</div>
                  ))
                : item.description
            }
          </div>

        </div>
      ))}

    </div>

  </div>
</section>
