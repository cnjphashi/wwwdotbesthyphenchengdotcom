---
import { siteData, navigation, relatedLinks } from '../data/siteData';
---

<footer class="bg-bg-footer border-t border-border-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 items-stretch">

      <!-- About Section -->
      <div class="flex flex-col justify-between">
        <h3 class="text-2xl font-bold text-primary mb-4">
          {siteData.name}
        </h3>

        <p class="text-text-tertiary text-m">
          {siteData.description}
        </p>
      </div>


      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold text-text-secondary mb-4">
          主要リンク
        </h4>

        <ul class="space-y-2">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-text-primary hover:text-primary transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>


      <!-- 関連リンク -->
      <div>
        <h4 class="text-lg font-semibold text-text-secondary mb-4">
          関連リンク
        </h4>

        <ul class="space-y-2">
          {relatedLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-text-primary hover:text-primary transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>


      <!-- Logo + Copyright -->
      <div class="flex flex-col justify-between items-center h-full">
        
        <img
          src="/hatcatoy-logo-800-by-800.webp"
          class="w-[61.8%] aspect-square"
          alt="Hatcatoy"
        />

        <p class="text-text-tertiary text-sm mt-8 text-center">
          &copy; {new Date().getFullYear()} Yiwu CJH Trading Co., Ltd. All rights reserved.
        </p>

      </div>

    </div>

  </div>
</footer>
