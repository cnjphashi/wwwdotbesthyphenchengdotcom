---
import { siteData, navigation, socialLinks, contactInfo, relatedLinks } from '../data/siteData';
---

<footer class="bg-bg-footer border-t border-border-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- About Section -->
      <div>
        <h3 class="text-2xl font-bold text-primary mb-4">{siteData.name}</h3>
        <p class="text-text-tertiary mb-4">{siteData.description}</p>
        <div class="flex space-x-4">
          {socialLinks.map((social) => (
            <a
              href={siteData.social[social.name as keyof typeof siteData.social]}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 bg-bg-primary hover:bg-primary text-text-primary hover:text-white rounded-lg flex items-center justify-center transition-all"
              aria-label={social.label}
            >
              <i class={`${social.icon} text-xl`}></i>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold text-text-secondary mb-4">主要リンク</h4>
        <ul class="space-y-2">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-text-primary hover:text-primary transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 関連リンク -->
      <div>
        <h4 class="text-lg font-semibold text-text-secondary mb-4">関連リンク</h4>
        <ul class="space-y-2">
          {relatedLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-text-primary hover:text-primary transition-colors"
                target="_blank"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <img  src="/hatcatoy-logo-800-by-800.webp" style="width: 61.8%; aspect-ratio: 1;">
      </div>
    </div>

    <div class="border-t border-border-secondary mt-8 pt-8 text-center text-text-primary">
      <p>&copy; {new Date().getFullYear()} Yiwu CJH Trading Co., Ltd. All rights reserved.</p>
    </div>
  </div>
</footer>

