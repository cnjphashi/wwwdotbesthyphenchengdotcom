---
import { Image } from 'astro:assets';
import { facilities } from '../data/siteData';
---

<div id="products">
<section id="facilities" class="py-20 bg-bg-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-2xl md:text-3xl font-medium text-primary mb-4">取扱商品</h2>
      <p class="text-xl text-text-tertiary max-w-2xl mx-auto">
        ぬいぐるみ・玩具・文房具・雑貨など、多彩な商品を取り揃えています。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {facilities.map((facility) => (
        <a href={facility.link} target="_blank">
        <div class="group bg-bg-secondary border-bg-secondary rounded-xl overflow-hidden border border-border-accent hover:border-primary transition-all transform" style="box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 4px -2px;">
          <div class="relative h-64 overflow-hidden">
            <Image
              src={facility.image}
              alt={facility.title}
              width={800}
              height={800}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            
            <div class="absolute bottom-4 left-4 right-4">
              
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-lg text-text-primary mb-2">{facility.title}</h3>
          </div>
        </div>
        </a>
      ))}
    </div>
  </div>
</section>
</div>
