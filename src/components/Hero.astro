---
import { heroVideo } from '@data/siteData';
---


<section
  class="
    relative
    w-full
    h-screen
    overflow-hidden
  "
>


  <!-- Hero Poster Background -->

  <img
    src={heroVideo.poster}
    alt={heroVideo.title}

    class="
      absolute
      inset-0

      w-full
      h-full

      object-cover
    "
  />



  <!-- Play Button -->

  <div
    class="
      absolute

      left-1/2
      top-1/2

      -translate-x-1/2
      -translate-y-1/2
    "
  >


    <!-- Ripple -->

    <span
      class="
        absolute
        inset-0

        rounded-full

        bg-primary/40

        animate-ping
      "
    ></span>


    <span
      class="
        absolute
        inset-0

        rounded-full

        bg-primary/20

        animate-pulse
      "
    ></span>



    <!-- Button -->

    <button
      id="open-video"

      aria-label="Play video"

      class="
        relative
        z-10

        w-24
        h-24

        rounded-full

        bg-primary

        text-white

        flex
        items-center
        justify-center

        shadow-xl

        transition-all
        duration-300

        cursor-pointer
      "
    >

      <svg
        class="
          w-10
          h-10

          ml-1
        "

        viewBox="0 0 24 24"

        fill="currentColor"
      >

        <path d="M8 5v14l11-7z"/>

      </svg>


    </button>


  </div>


</section>





<!-- Video Lightbox -->


<div
  id="video-lightbox"

  class="
    fixed

    inset-0

    z-[999]

    hidden

    items-center
    justify-center

    bg-black/80

    backdrop-blur-sm
  "
>


  <div
    class="
      relative

      w-[90%]

      max-w-6xl

      aspect-video
    "
  >


    <!-- Close -->

    <button
      id="close-video"

      aria-label="Close video"

      class="
        absolute

        -top-12

        right-0

        text-white

        text-4xl

        leading-none

        cursor-pointer
      "
    >

      ×

    </button>




    <!-- Video -->


    <video
      id="video-player"

      class="
        w-full

        h-full

        rounded-lg

        object-contain

        bg-black
      "

      poster={heroVideo.poster}

      controls

      preload="metadata"

    >

      <source
        src={heroVideo.src}

        type="video/mp4"
      />


    </video>


  </div>


</div>





<script>


const openButton =
  document.getElementById(
    "open-video"
  );


const closeButton =
  document.getElementById(
    "close-video"
  );


const lightbox =
  document.getElementById(
    "video-lightbox"
  );


const video =
  document.getElementById(
    "video-player"
  );





function openVideo(){

  lightbox?.classList.remove(
    "hidden"
  );


  lightbox?.classList.add(
    "flex"
  );


  video?.play();

}





function closeVideo(){

  lightbox?.classList.add(
    "hidden"
  );


  lightbox?.classList.remove(
    "flex"
  );


  video?.pause();


  if(video){

    video.currentTime = 0;

  }

}





openButton?.addEventListener(
  "click",
  openVideo
);



closeButton?.addEventListener(
  "click",
  closeVideo
);





lightbox?.addEventListener(
  "click",
  (event)=>{

    if(event.target === lightbox){

      closeVideo();

    }

  }
);





document.addEventListener(
  "keydown",
  (event)=>{

    if(
      event.key === "Escape" &&
      lightbox &&
      !lightbox.classList.contains("hidden")
    ){

      closeVideo();

    }

  }
);


</script>
