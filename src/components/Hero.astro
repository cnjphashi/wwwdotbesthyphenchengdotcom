---
import { Image } from 'astro:assets';
import HeroImage1 from "@assets/photo-1534438327276-14e5300c3a48.jpg";

// 定义轮播图片数据
const slides = [
  { img: HeroImage1, alt: "Slide 1" },
  { img: HeroImage1, alt: "Slide 2" },
  { img: HeroImage1, alt: "Slide 3" },
];
---

<!-- 1. 通过 CDN 引入 Swiper 的 CSS 与 JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<section class="relative w-full h-screen overflow-hidden bg-black">

  <!-- 2. 全屏图片轮播区域 -->
  <div class="swiper hero-swiper w-full h-full">
    <div class="swiper-wrapper">
      {slides.map((slide) => (
        <div class="swiper-slide w-full h-full">
          <Image 
            src={slide.img} 
            alt={slide.alt} 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- 3. 左下角：前进 / 暂停 / 后退 按钮 -->
  <div class="absolute bottom-6 left-6 z-30 flex items-center gap-3">
    <button id="btn-prev" aria-label="Previous Slide" class="w-10 h-10 rounded-full bg-black/40 hover:bg-black/70 text-white transition-all flex items-center justify-center backdrop-blur-md border border-white/20">
      <i class="ri-arrow-left-s-line text-xl"></i>
    </button>
    <button id="btn-toggle-play" aria-label="Play/Pause" class="w-10 h-10 rounded-full bg-black/40 hover:bg-black/70 text-white transition-all flex items-center justify-center backdrop-blur-md border border-white/20">
      <i id="play-icon" class="ri-pause-fill text-base"></i>
    </button>
    <button id="btn-next" aria-label="Next Slide" class="w-10 h-10 rounded-full bg-black/40 hover:bg-black/70 text-white transition-all flex items-center justify-center backdrop-blur-md border border-white/20">
      <i class="ri-arrow-right-s-line text-xl"></i>
    </button>
  </div>

  <!-- 4. 底部中间：向下滑动提示 -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30 animate-bounce cursor-pointer">
    <i class="ri-arrow-down-line text-3xl text-white drop-shadow-md"></i>
  </div>

  <!-- 5. 右下角：页码指示器 (如 1 / 3) -->
  <div class="absolute bottom-6 right-6 z-30 font-mono text-base text-white/90 bg-black/40 px-4 py-1.5 rounded-full backdrop-blur-md border border-white/20">
    <span id="current-slide">1</span> / <span id="total-slides">{slides.length}</span>
  </div>

</section>

<!-- 6. 纯客户端 Script（使用 is:inline，避免 Vite 在构建时打包打包找不到依赖） -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let isPlaying = true;

    // 直接使用通过 CDN 注入到全局的 Swiper 构造函数
    const swiper = new Swiper('.hero-swiper', {
      loop: true,
      speed: 600,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
      },
      on: {
        slideChange(s) {
          const currentEl = document.getElementById('current-slide');
          if (currentEl) {
            currentEl.textContent = String(s.realIndex + 1);
          }
        }
      }
    });

    // 左下角控制按钮事件绑定
    document.getElementById('btn-prev')?.addEventListener('click', () => swiper.slidePrev());
    document.getElementById('btn-next')?.addEventListener('click', () => swiper.slideNext());
    
    // 播放 / 暂停切换逻辑
    const toggleBtn = document.getElementById('btn-toggle-play');
    const playIcon = document.getElementById('play-icon');

    toggleBtn?.addEventListener('click', () => {
      if (isPlaying) {
        swiper.autoplay.stop();
        playIcon?.classList.replace('ri-pause-fill', 'ri-play-fill');
      } else {
        swiper.autoplay.start();
        playIcon?.classList.replace('ri-play-fill', 'ri-pause-fill');
      }
      isPlaying = !isPlaying;
    });
  });
</script>
