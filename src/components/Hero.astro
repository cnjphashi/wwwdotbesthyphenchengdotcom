---
import { heroSlider, heroVideo } from '@data/siteData';

const hero = heroSlider[0];
---

<section
  class="
    relative
    w-full
    h-screen
    overflow-hidden
  "
>

  <!-- Hero Background -->
  <img
    src={hero.image}
    alt={hero.title}
    class="
      absolute
      inset-0

      w-full
      h-full

      object-cover
    "
  />


  <!-- Overlay -->
  <div
    class="
      absolute
      inset-0

      bg-black/25
    "
  ></div>



  <!-- Play Button -->
  <button
    id="open-video"
    aria-label="Play company video"

    class="
      absolute

      left-1/2
      top-1/2

      -translate-x-1/2
      -translate-y-1/2


      w-24
      h-24

      rounded-full

      bg-primary

      text-white

      flex
      items-center
      justify-center


      shadow-xl


      transition-all
      duration-300

      hover:scale-110

      cursor-pointer
    "
  >

    <svg
      class="
        w-10
        h-10

        ml-1
      "
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path d="M8 5v14l11-7z"/>
    </svg>


  </button>


</section>





<!-- Video Lightbox -->

<div
  id="video-lightbox"

  class="
    fixed

    inset-0

    z-[999]

    hidden

    items-center
    justify-center

    bg-black/80

    backdrop-blur-sm
  "
>


  <div
    class="
      relative

      w-[90%]

      max-w-6xl

      aspect-video
    "
  >


    <!-- Close Button -->
    <button
      id="close-video"

      aria-label="Close video"

      class="
        absolute

        -top-12

        right-0

        text-white

        text-4xl

        leading-none

        cursor-pointer
      "
    >
      ×
    </button>



    <!-- Video -->

    <video

      id="video-player"

      class="
        w-full

        h-full

        rounded-lg

        object-contain

        bg-black
      "

      poster={heroVideo.poster}

      controls

      preload="metadata"

    >

      <source
        src={heroVideo.src}
        type="video/mp4"
      />

    </video>


  </div>


</div>





<script>

const openButton =
document.getElementById(
  "open-video"
);


const closeButton =
document.getElementById(
  "close-video"
);


const lightbox =
document.getElementById(
  "video-lightbox"
);


const video =
document.getElementById(
  "video-player"
);





function openVideo(){

  lightbox?.classList.remove(
    "hidden"
  );

  lightbox?.classList.add(
    "flex"
  );


  video?.play();

}




function closeVideo(){

  lightbox?.classList.add(
    "hidden"
  );

  lightbox?.classList.remove(
    "flex"
  );


  video?.pause();


  if(video){
    video.currentTime = 0;
  }

}





openButton?.addEventListener(
  "click",
  openVideo
);



closeButton?.addEventListener(
  "click",
  closeVideo
);





lightbox?.addEventListener(
  "click",
  (event)=>{

    if(event.target === lightbox){

      closeVideo();

    }

  }
);





document.addEventListener(
  "keydown",
  (event)=>{

    if(
      event.key === "Escape" &&
      !lightbox?.classList.contains("hidden")
    ){

      closeVideo();

    }

  }
);


</script>
