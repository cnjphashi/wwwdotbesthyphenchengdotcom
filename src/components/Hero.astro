---
import { Image } from 'astro:assets';
import HeroImage1 from "@assets/photo-1534438327276-14e5300c3a48.jpg";

// 定义轮播图片数据
const slides = [
  { img: HeroImage1, alt: "Slide 1" },
  { img: HeroImage1, alt: "Slide 2" },
  { img: HeroImage1, alt: "Slide 3" },
];
---

<!-- 1. 引入 Swiper 的 CSS 与 JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<section class="relative w-full h-screen overflow-hidden bg-black">

  <!-- 2. 全屏图片轮播区域 -->
  <div class="swiper hero-swiper w-full h-full">
    <div class="swiper-wrapper">
      {slides.map((slide) => (
        <div class="swiper-slide w-full h-full">
          <Image 
            src={slide.img} 
            alt={slide.alt} 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- 3. 左下角：前进 / 带有纯净倒计时进度圈的暂停 / 后退 按钮 -->
  <div class="absolute bottom-6 left-6 z-30 flex items-center gap-3">
    <!-- 上一张 -->
    <button id="btn-prev" aria-label="Previous Slide" class="w-11 h-11 rounded-full bg-black/40 hover:bg-black/70 text-white transition-all flex items-center justify-center backdrop-blur-md">
      <i class="ri-arrow-left-s-line text-xl"></i>
    </button>
    
    <!-- 播放/暂停（去除 CSS Border，仅保留单一 SVG 进度圈） -->
    <button id="btn-toggle-play" aria-label="Play/Pause" class="relative w-11 h-11 rounded-full bg-black/40 hover:bg-black/70 text-white transition-all flex items-center justify-center backdrop-blur-md group">
      <!-- SVG 环形进度条 -->
      <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none p-[1px]" viewBox="0 0 44 44">
        <!-- 底圈轨道（代替 CSS 边框） -->
        <circle cx="22" cy="22" r="20" stroke="currentColor" stroke-width="2" class="text-white/30 fill-none" />
        <!-- 动态进度圈 -->
        <circle 
          id="progress-circle" 
          cx="22" 
          cy="22" 
          r="20" 
          stroke="currentColor" 
          stroke-width="2" 
          stroke-dasharray="125.6" 
          stroke-dashoffset="125.6" 
          stroke-linecap="round" 
          class="text-white fill-none transition-all duration-75" 
        />
      </svg>

      <!-- 播放/暂停图标 -->
      <i id="play-icon" class="ri-pause-fill text-base relative z-10"></i>
    </button>

    <!-- 下一张 -->
    <button id="btn-next" aria-label="Next Slide" class="w-11 h-11 rounded-full bg-black/40 hover:bg-black/70 text-white transition-all flex items-center justify-center backdrop-blur-md">
      <i class="ri-arrow-right-s-line text-xl"></i>
    </button>
  </div>

  <!-- 4. 底部中间：精致的高级感向下滑动提示组件 -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2 cursor-pointer group">
    <span class="text-[10px] tracking-[0.25em] uppercase font-sans text-white/70 font-light group-hover:text-white transition-colors drop-shadow">
      Scroll
    </span>
    <!-- 极简高定风格鼠标胶囊轮廓 -->
    <div class="w-5 h-8 border-[1.5px] border-white/60 rounded-full flex justify-center p-1 group-hover:border-white transition-colors backdrop-blur-xs shadow-sm">
      <!-- 滚轮滑动点 -->
      <div class="w-1 h-2 bg-white rounded-full animate-wheel-scroll"></div>
    </div>
  </div>

  <!-- 5. 右下角：页码指示器 (如 1 / 3) -->
  <div class="absolute bottom-6 right-6 z-30 font-mono text-sm tracking-wider text-white/90 bg-black/40 px-4 py-2 rounded-full backdrop-blur-md">
    <span id="current-slide">1</span> / <span id="total-slides">{slides.length}</span>
  </div>

</section>

<!-- 质感滚动条动画样式 -->
<style>
  @keyframes wheel-scroll {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .animate-wheel-scroll {
    animation: wheel-scroll 1.6s infinite ease-in-out;
  }
</style>

<!-- 轮播与进度条交互脚本 -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let isPlaying = true;
    const progressCircle = document.getElementById('progress-circle');
    const circumference = 2 * Math.PI * 20; // 2 * π * r (r=20) = ~125.6

    const swiper = new Swiper('.hero-swiper', {
      loop: true,
      speed: 600,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
      },
      on: {
        // 利用 autoplayTimeLeft 实时更新圆弧 offset
        autoplayTimeLeft(s, time, progress) {
          if (progressCircle && isPlaying) {
            const offset = circumference * progress;
            progressCircle.style.strokeDashoffset = String(offset);
          }
        },
        slideChange(s) {
          const currentEl = document.getElementById('current-slide');
          if (currentEl) {
            currentEl.textContent = String(s.realIndex + 1);
          }
        }
      }
    });

    // 绑定前进/后退
    document.getElementById('btn-prev')?.addEventListener('click', () => swiper.slidePrev());
    document.getElementById('btn-next')?.addEventListener('click', () => swiper.slideNext());
    
    // 播放 / 暂停逻辑与进度条重置
    const toggleBtn = document.getElementById('btn-toggle-play');
    const playIcon = document.getElementById('play-icon');

    toggleBtn?.addEventListener('click', () => {
      if (isPlaying) {
        swiper.autoplay.stop();
        playIcon?.classList.replace('ri-pause-fill', 'ri-play-fill');
        if (progressCircle) {
          progressCircle.style.strokeDashoffset = String(circumference); // 暂停时清除进度弧
        }
      } else {
        swiper.autoplay.start();
        playIcon?.classList.replace('ri-play-fill', 'ri-pause-fill');
      }
      isPlaying = !isPlaying;
    });
  });
</script>
